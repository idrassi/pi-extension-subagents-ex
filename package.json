{
  "name": "pi-subagents-ex",
  "version": "1.0.0",
  "description": "Advanced multi-agent orchestration for pi: background tasks, worktree isolation, retries, turn/time budgets, JSON output contracts, run history, and a live dashboard.",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "eval": "node scripts/evaluate.ts"
  },
  "license": "MIT",
  "files": [
    "index.ts",
    "src/",
    "agents/",
    "prompts/"
  ],
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "subagents",
    "agents",
    "orchestration"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "ajv": "8.17.1",
    "proper-lockfile": "4.1.2"
  },
  "bundledDependencies": [
    "ajv",
    "proper-lockfile"
  ],
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=0.86.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": { "optional": true },
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.99.1",
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@earendil-works/pi-tui": "0.99.1",
    "@types/node": "24.0.0",
    "@types/proper-lockfile": "4.1.4",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
